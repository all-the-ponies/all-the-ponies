{
  "name": "all-the-ponies",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && npm run build:sitemap",
    "build:sitemap": "tsx ./scripts/generate-sitemap.ts",
    "preview": "npm run build && vike preview --port 5000",
    "deploy": "npm run build && wrangler deploy",
    "type-check": "vue-tsc --build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.43.1",
    "@nozbe/microfuzz": "^1.0.0",
    "@vikejs/hono": "^0.2.1",
    "@vueuse/core": "^14.3.0",
    "accept-language": "^3.0.20",
    "hono": "^4.12.28",
    "ky": "^1.14.3",
    "papaparse": "^5.5.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sitemap": "^9.0.1",
    "v-lazy-image": "^2.1.1",
    "vike": "^0.4.260",
    "vike-vue": "^0.9.13",
    "vike-vue-pinia": "^0.2.6",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-virtual-scroller": "^2.0.1",
    "wrangler": "^4.107.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.7.0",
    "navigation-api-types": "^0.6.1",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.6",
    "workbox-window": "^7.4.1"
  }
}
