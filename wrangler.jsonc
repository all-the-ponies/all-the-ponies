{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-16",
  "name": "all-the-ponies",
  "main": "vike:server-entry",
  // Only required if your app (or one of your libraries) uses a Node.js API
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "all-the-ponies.com/*",
      "zone_name": "all-the-ponies.com"
    },
    {
      "pattern": "all-the-ponies.com/game-assets/*",
      "zone_name": "all-the-ponies.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS_BUCKET",
      "bucket_name": "all-the-ponies-assets",
      "remote": true
    }
  ],
  "kv_namespaces": [{
    "binding": "ALL_THE_PONIES_KV",
    "id": "f739af9221164ea98dfe6f46a8ad779c"
  }]
}
